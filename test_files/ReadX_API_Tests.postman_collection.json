        {
          "name": "POST Generate Quiz",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains generated quiz payload\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.action).to.eql(\"quiz\");",
                  "    pm.expect(json.text).to.be.a(\"string\");",
                  "    pm.expect(json.text.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"Quiz content is valid JSON questions array\", function () {",
                  "    var json = pm.response.json();",
                  "    var clean = json.text.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, '').trim();",
                  "    try {",
                  "        var questions = JSON.parse(clean);",
                  "        pm.expect(questions).to.be.an(\"array\");",
                  "        if (questions.length > 0) {",
                  "            pm.expect(questions[0]).to.have.property(\"question\");",
                  "            pm.expect(questions[0]).to.have.property(\"options\");",
                  "            pm.expect(questions[0]).to.have.property(\"answerIndex\");",
                  "        }",
                  "    } catch (e) {",
                  "        // Fallback validation if model returns raw text",
                  "        pm.expect(json.text.length).to.be.above(20);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
