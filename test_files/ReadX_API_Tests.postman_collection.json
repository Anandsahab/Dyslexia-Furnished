    {
      "name": "03 - Structured Concept Cards (Visual Learning)",
      "item": [
        {
          "name": "POST Visualize Content (Concept Cards)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response matches Concept Cards schema\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.action).to.eql(\"visualize\");",
                  "    pm.expect(json.visualType).to.eql(\"concept_cards\");",
                  "    ",
                  "    pm.expect(json.visualData).to.be.an(\"object\");",
                  "    pm.expect(json.visualData.title).to.be.a(\"string\");",
                  "    pm.expect(json.visualData.summary).to.be.a(\"string\");",
                  "    pm.expect(json.visualData.conceptCards).to.be.an(\"array\");",
                  "    pm.expect(json.visualData.conceptCards.length).to.be.at.least(1);",
                  "    ",
                  "    var firstCard = json.visualData.conceptCards[0];",
                  "    pm.expect(firstCard.id).to.exist;",
                  "    pm.expect(firstCard.term).to.be.a(\"string\");",
                  "    pm.expect(firstCard.definition).to.be.a(\"string\");",
                  "    pm.expect(firstCard.plainExplanation).to.be.a(\"string\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"visualize\",\n  \"text\": \"Binary search is an efficient algorithm for finding an item from a sorted list of items. It works by repeatedly dividing in half the portion of the list that could contain the item until you narrow down the possible locations to just one.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/gemini",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gemini"]
            },
            "description": "Extracts key educational concepts from reading content and returns validated concept cards conforming to CONCEPT_CARDS_SCHEMA."
          },
          "response": []
        }
