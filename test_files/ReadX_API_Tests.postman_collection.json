                  "pm.test(\"Response structure for simplify action is valid\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.action).to.eql(\"simplify\");",
                  "    pm.expect(json.text).to.be.a(\"string\");",
                  "    pm.expect(json.text.length).to.be.above(0);",
                  "    pm.expect(json.model).to.exist;",
                  "});",
                  "",
                  "pm.test(\"Sensitive API key is not leaked in response text\", function () {",
                  "    var text = pm.response.text();",
                  "    pm.expect(text).to.not.include(\"AIzaSy\");",
                  "});"
