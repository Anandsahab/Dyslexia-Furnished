{
  "info": {
    "_postman_id": "a91e5c2b-4e12-4f89-8d14-readx-api-tests",
    "name": "ReadX API Tests",
    "description": "Comprehensive automated Postman test suite for ReadX Assistive Reading Platform API (/api/gemini).\n\nIncludes positive and negative test cases for:\n- Service Health Check & Preflight (GET, OPTIONS)\n- Assistive AI reading features (simplify, explain, summarize, quiz, generate)\n- Structured Concept Cards (visualize action)\n- Input validation and HTTP status code mappings (400, 405)\n\nZero API keys or credentials are stored in this collection; requests proxy through the backend server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "Base URL for the server. Set to 'http://localhost:3000' for local dev-server or 'https://dyslexia-1.vercel.app' for deployed production testing."
    }
  ],
  "item": [
    {
      "name": "01 - Health & CORS Preflight",
      "item": [
        {
          "name": "GET Service Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has valid health check structure\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an(\"object\");",
                  "    pm.expect(json.ok).to.eql(true);",
                  "    pm.expect(json.service).to.eql(\"gemini\");",
                  "    pm.expect(json.status).to.eql(\"ready\");",
                  "});",
                  "",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gemini",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gemini"]
            },
            "description": "Verifies that the Gemini serverless API endpoint is online and ready without passing any prompt parameters."
          },
          "response": []
        },
        {
          "name": "OPTIONS CORS Preflight",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"CORS headers are correctly returned\", function () {",
                  "    pm.response.to.have.header(\"Access-Control-Allow-Origin\");",
                  "    pm.response.to.have.header(\"Access-Control-Allow-Methods\");",
                  "    pm.response.to.have.header(\"Access-Control-Allow-Headers\");",
                  "    ",
                  "    var methods = pm.response.headers.get(\"Access-Control-Allow-Methods\");",
                  "    pm.expect(methods).to.include(\"GET\");",
                  "    pm.expect(methods).to.include(\"POST\");",
                  "    pm.expect(methods).to.include(\"OPTIONS\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:5500"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gemini",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gemini"]
            },
            "description": "Verifies that OPTIONS preflight requests return required CORS headers for cross-origin frontend calls."
          },
          "response": []
        }
      ]
    },
