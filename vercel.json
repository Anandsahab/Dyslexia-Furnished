{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/gemini",
      "destination": "/api/gemini.js"
    },
    {
      "source": "/api/notes",
      "destination": "/api/notes.js"
    },
    {
      "source": "/api/streak",
      "destination": "/api/streak.js"
    }
  ]
}